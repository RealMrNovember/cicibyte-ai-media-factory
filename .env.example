# CiciByte AI Media Factory — example configuration.
# Copy to .env (deploy/install.sh does this for you). Never commit .env.

# PostgreSQL connection
MF_DATABASE_URL=postgresql+psycopg://mf:CHANGE_ME@db:5432/mf

# Secret used to encrypt API keys and OAuth tokens. At least 32 characters.
# Changing it makes stored secrets unreadable.
MF_SECRET_KEY=

# Data directory inside the container (media, models, backups)
MF_DATA_DIR=/data

# Bind address of the API/panel
MF_BIND_HOST=127.0.0.1
MF_BIND_PORT=8080

# Host names the panel may be reached by (JSON list)
MF_ALLOWED_HOSTS=["localhost","127.0.0.1"]

# Session lifetime in hours
MF_SESSION_TTL_HOURS=72
